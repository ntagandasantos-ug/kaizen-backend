# ---- Database ----
# From your Railway/Render/Supabase Postgres instance
DATABASE_URL=postgres://user:password@host:5432/kaizen

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Object storage (Cloudflare R2 or AWS S3) ----
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=kaizen-audit-media
# Public base URL for reading files back (R2 public bucket URL or your own CDN domain)
S3_PUBLIC_BASE=https://media.yourdomain.com

# ---- App ----
PORT=4000
CORS_ORIGIN=http://localhost:5173
# First admin account, created automatically by the seed script
SEED_ADMIN_EMAIL=admin@bucos.ug
SEED_ADMIN_PASSWORD=change_me_immediately
